---
/**
 * TopBar.astro
 * ============
 */
import Icon from '@components/ui/Icon.astro';
import TagsPanel from '@components/site/topbar/TagsPanel.astro';
import SharePanel from '@components/site/topbar/SharePanel.astro';
import SettingsPanel from '@components/site/topbar/SettingsPanel.astro';
import { getIconSvg } from '@utils/fontawesome';

const moonSvg = getIconSvg('fas', 'moon');
const sunSvg = getIconSvg('fas', 'sun');
---

<div class="top-nav">
  <div class="toggle-btn-container">
    <button aria-label="open-close-button" class="toggle-btn">
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
    </button>
  </div>

  <div class="left">
    <a href="/" class="top-buttons" id="Home-button">home</a>
    <a href="/about" class="top-buttons" id="About-button">about</a>
  </div>

  <div class="right">
    <div class="search-bar-container" id="searchBarContainer">
      <input
        id="searchBar"
        autocomplete="off"
        class="search-bar"
        placeholder="Type / to search"
      />
      <input
        id="searchBarMobile"
        autocomplete="off"
        class="search-bar-mobile"
        placeholder="Search here"
      />
      <div class="autocomplete-dropdown" id="autocomplete-dropdown"></div>
      <div class="search-overlay" id="searchOverlay"></div>
    </div>

    <div class="buttons-container">
      <button
        type="button"
        id="searchIconBtn"
        class="topbar-icon-btn search-icon-btn"
        aria-label="open-search"
      >
        <Icon name="magnifying-glass" />
      </button>
      <abbr title="browse by tag">
        <button
          type="button"
          id="tagsBtn"
          class="topbar-icon-btn"
          aria-label="browse-tags"
          aria-controls="tagsPanel"
          aria-expanded="false"
        >
          <Icon name="tags" />
        </button>
      </abbr>
      <abbr title="share this page">
        <button
          type="button"
          id="shareBtn"
          class="topbar-icon-btn"
          aria-label="share-page"
          aria-controls="sharePanel"
          aria-expanded="false"
        >
          <Icon name="share-nodes" />
        </button>
      </abbr>
      <abbr title="RSS" class="rss">
        <a aria-label="rss" href="/rss/feed.xml" class="topbar-icon-btn">
          <Icon name="rss" />
        </a>
      </abbr>
      <abbr title="dark/light mode">
        <button
          class="topbar-icon-btn dark-mode-button"
          aria-label="dark-mode-button"
          id="modeToggle"
        >
          <span id="toggleIcon">
            <Icon name="moon" />
          </span>
        </button>
        <script is:inline define:vars={{ moonSvg, sunSvg }}>
          window.__iconSvg = { moon: moonSvg, sun: sunSvg };
        </script>
      </abbr>
      <abbr title="settings">
        <button
          type="button"
          id="settingsBtn"
          class="topbar-icon-btn settings-icon-btn"
          aria-label="settings"
          aria-controls="settingsPanel"
          aria-expanded="false"
        >
          <Icon name="gear" />
        </button>
      </abbr>
    </div>

    <TagsPanel />
    <SharePanel />
    <SettingsPanel />
  </div>

  <div class="progress-container">
    <div class="progress-bar" id="myBar"></div>
  </div>
</div>

<script>
  import { initNav } from "./topbar/nav";
  import { initDarkMode } from "./topbar/theme";
  import { initProgressBar } from "./topbar/settings";
  import { initSearch } from "./topbar/search";

  initNav();
  initDarkMode();
  initProgressBar();
  initSearch();
</script>

<style>
  @import "./TopBar.css";

  #toggleIcon {
    display: inline-flex;
    align-items: center;
    height: 1em;
  }
  #toggleIcon :global(svg),
  #toggleIcon :global(.svg-icon svg) {
    height: 1em;
    width: auto;
    fill: currentColor;
  }
</style>
