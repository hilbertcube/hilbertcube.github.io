---
/**
 * SharePanel.astro
 * ================
 * A row of icon-only platform buttons (the name is their tooltip and
 * aria-label). Behaviour
 * in share.ts.
 *
 * Adding a platform: an entry in `sharePlatforms` below and the same `id` in
 * `SHARE_URLS` in share.ts.
 */
import Icon from "@components/ui/Icon.astro";
import Panel from "@components/site/topbar/Panel.astro";

// `color` is the brand colour of the icon; none = the panel's text colour.
const sharePlatforms = [
  { id: "facebook", title: "Facebook", icon: "facebook", color: "#1877f2" },
  { id: "twitter", title: "X", icon: "x-twitter" },
  { id: "bluesky", title: "Bluesky", icon: "bluesky", color: "#1185fe" },
  { id: "whatsapp", title: "WhatsApp", icon: "whatsapp", color: "#25d366" },
  { id: "reddit", title: "Reddit", icon: "reddit", color: "#ff4500" },
  { id: "hackernews", title: "Hacker News", icon: "hacker-news", color: "#ff6600" },
  { id: "telegram", title: "Telegram", icon: "telegram", color: "#26a5e4" },
];
---

<Panel id="sharePanel" title="Share this page" width={300}>
  <div class="tb-panel-section">
    <div class="share-platforms">
      {
        sharePlatforms.map((platform) => (
          <button
            type="button"
            class="share-option"
            data-share={platform.id}
            aria-label={`Share to ${platform.title}`}
            title={platform.title}
            style={platform.color ? `--brand: ${platform.color}` : undefined}
          >
            <Icon name={platform.icon} prefix="fab" class="share-option-icon" />
          </button>
        ))
      }
    </div>
  </div>
</Panel>

<script>
  import { initShare } from "./share";

  initShare();
</script>

<style>
  /* All platforms on one row, one equal cell each. */
  .share-platforms {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 2px;
    margin: 0 -6px;
  }

  .share-option {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 4px;
    background: none;
    cursor: pointer;
  }

  .share-option:hover {
    background-color: var(--panel-hover);
  }

  /* The platform's brand colour, set inline per option. Icon renders the span,
     so the class arrives unscoped. */
  .share-option :global(.share-option-icon) {
    flex: none;
    font-size: calc(20px * var(--panel-scale));
    color: var(--brand, var(--panel-text));
  }
</style>
