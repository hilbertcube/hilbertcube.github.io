---
/**
 * HighlightsAndAttribute.astro
 * ============================
 */
import { getCollection } from "astro:content";
import { getRepoStats } from "@utils/repoStats";

const articles = (await getCollection("articles")).map((entry) => entry.data);
const posts = await getCollection("posts");

// Hand-picked sidebar highlights, in display order. Keyed on `link` — the
// catalog's primary key — so a typo here fails loudly (the entry drops out)
// rather than silently pointing at a stale id.
const highlightLinks = [
  "/articles/accelerating-feature-extraction-and-image-stitching-algorithm",
  "/articles/the-quest-to-finding-chladni-patterns-1",
  "/articles/the-quest-to-finding-chladni-patterns-2",
  "/articles/maximum-and-minimum",
];
const highlights = highlightLinks
  .map((link) => articles.find((a) => a.link === link))
  .filter((a) => a !== undefined);

// Read from git during the build instead of from the GitHub API in the browser.
const stats = getRepoStats();

// Built without indentation: the panel renders with `white-space: pre-line`,
// which keeps the newlines but would collapse any leading spaces into one.
const repoStats = [
  "",
  `Total Updates: ${stats.totalUpdates}`,
  `Lines of Code: ${stats.linesOfCode}`,
  `Total Articles: ${articles.length}`,
  `Total Posts: ${posts.length}`,
  `Repository Age: ${stats.repositoryAge}`,
].join("\n");

const commitInfo = [
  "",
  `Last Updated: ${stats.lastUpdated}`,
  `Commit: ${stats.lastCommitMessage}`,
].join("\n");
---

<div class="side-nav-content-container">
  <section style="border-top: 1px solid #b4b4b4;">
    <header class="major">
      <h2 style="margin: 0.75em 0;">Website's Data</h2>
    </header>
    <div class="commit-log-container">
      <div class="commit-log-content">
        <span class="commit-log-header">&gt; Read from git at build time</span>
        <span id="repo-stats">{repoStats}</span>
        <span id="commit-info">{commitInfo}</span>
      </div>
    </div>
    <style is:global>
      .commit-log-container {
        max-width: 300px;
        margin: 20px auto;
        border-radius: 6px;
        padding: 5px 16px;
      }
      .light-mode .commit-log-container {
        background: #f5f5f5;
        border: 1px solid #d0d0d0;
      }
      .dark-mode .commit-log-container {
        background: #1e1e1e;
        border: 1px solid #3e3e3e;
      }
      .commit-log-content {
        font-family: "Courier New", Consolas, monospace;
        font-size: 11px;
        line-height: 1.6;
        white-space: pre-line;
        word-wrap: break-word;
        overflow-wrap: break-word;
      }
      .light-mode .commit-log-content {
        color: #2e2e2e;
      }
      .dark-mode .commit-log-content {
        color: #d4d4d4;
      }
      .light-mode .commit-log-header {
        color: #22863a;
      }
      .dark-mode .commit-log-header {
        color: #6a9955;
      }
    </style>
  </section>

  <section>
    <header class="major">
      <h2 style="margin: 0.75em 0;">Highlights</h2>
    </header>
    <div class="highlights">
      <ul id="suggestion-container">
        {
          highlights.map((article) => (
            <li class="home-li">
              <span>{article.title}</span>
              <a href={article.link} target="_blank" class="recommend-img">
                <img
                  src={`/media/Images/${article.image}`}
                  alt={article.title}
                  loading="lazy"
                  style="max-height: 0; opacity: 0;"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section>
    <div class="attribute">
      <div
        style="font-weight: bold; font-size: 1em; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px;"
      >
        About this Website
      </div>
      <div>Logo generated by a recursive algorithm</div>
      <div>Website designed by me</div>
      <div>
        Design inspired by <a
          href="https://html5up.net/editorial"
          class="hyperlink"
          target="_blank">Editorial</a
        > by HTML5 UP
      </div>
      <div>Idea from 2023, created in 2024</div>
    </div>
  </section>
</div>

<script>
  // Each highlight expands to reveal its cover image; the link only becomes
  // clickable once expanded, so the first tap expands instead of navigating.
  document.querySelectorAll<HTMLElement>(".home-li").forEach((li) => {
    const img = li.querySelector("img");
    const link = li.querySelector<HTMLElement>("a");
    if (!img || !link) return;

    const isExpanded = () => img.style.maxHeight !== "0px" && !!img.style.maxHeight;

    img.style.maxHeight = img.style.maxHeight || "0";
    img.style.opacity = img.style.opacity || "0";
    link.style.pointerEvents = isExpanded() ? "auto" : "none";

    li.addEventListener("click", () => {
      const expanded = isExpanded();
      img.style.maxHeight = expanded ? "0" : img.naturalHeight + "px";
      img.style.opacity = expanded ? "0" : "1";
      link.style.pointerEvents = expanded ? "none" : "auto";
      link.classList.toggle("show-read-more", !expanded);
    });
  });
</script>

<style>
  .side-nav-content-container {
    padding: 0 15px;
  }

  .side-nav-content-container > section {
    padding-top: 10px;
    padding-bottom: 25px;
    margin: 0;
    border-bottom: 1px solid #b4b4b4;
  }

  /* === HIGHLIGHTS === */

  .highlights li,
  .highlights ul {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .highlights ul {
    gap: 0;
    padding-top: 0;
    padding-bottom: 0;
  }

  .highlights li {
    padding: 0;
    font-size: 16px;
    font-weight: 550;
    transition: height var(--highlight-drop-time) ease;
  }

  .highlights ul li {
    padding: 5px;
    text-align: left;
    background: var(--nav-bar-color);
    cursor: pointer;
  }

  .highlights ul li:hover {
    border-left: 2px solid red;
  }

  .highlights span {
    margin: 0;
  }

  .highlights a {
    margin: 0;
    padding: 0;
    transition: height var(--highlight-drop-time) ease, opacity 0.2s ease 0.1s;
    color: inherit;
    font-size: 0;
  }

  /* Cover image is collapsed until the entry is clicked; the inline
     max-height/opacity the script sets drive the reveal. */
  .highlights li img {
    border-radius: 5px;
    width: 100%;
    height: auto;
    margin: 7px 0;
    max-height: 0;
    opacity: 0;
    transition: max-height var(--highlight-drop-time) ease, opacity 0.2s ease 0.1s;
  }

  .highlights li:hover img {
    opacity: 1;
    position: relative;
  }

  .recommend-img {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .recommend-img::after {
    content: "Read More";
    font-family: "Jura", sans-serif;
    font-weight: 400;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: rgba(0, 0, 0, 0.6);
    color: #fff;
    padding: 15px;
    border-radius: 8px;
    font-size: 15px;
    text-align: center;
    display: none;
    z-index: 1;
  }

  .recommend-img.show-read-more::after {
    display: block;
  }

  /* === ATTRIBUTION === */

  .attribute {
    padding-top: 18px;
    width: 90%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    row-gap: 12px;
    font-family: inherit;
    font-size: 14px;
    color: #9c9c9c;
    text-align: center;
    opacity: 1;
    transition: opacity var(--fade-in-out-time) ease;
  }

  /* .navbar is the sidebar element in BaseLayout, outside this component. */
  :global(.navbar.closed) .attribute {
    opacity: 0;
  }
</style>
