---
/**
 * ShareButton.astro
 * =================
 */
import Icon from '@components/ui/Icon.astro';

const platforms = [
  { id: "facebook", title: "Facebook", icon: "facebook" },
  { id: "twitter", title: "Twitter", icon: "x-twitter" },
  { id: "whatsapp", title: "Whatsapp", icon: "whatsapp" },
  { id: "reddit", title: "Reddit", icon: "reddit" },
  { id: "hackernews", title: "Hacker News", icon: "hacker-news" },
  { id: "telegram", title: "Telegram", icon: "telegram" },
];
---

<button aria-label="social-media-button" class="share-button">
  <Icon name="share-nodes" id="share-expand" />
  <span class="share-tooltip">Share this page</span>
</button>

<div class="share-options" id="shareOptions">
  {
    platforms.map((platform) => (
      <abbr title={platform.title}>
        <button
          class="share-option"
          data-share={platform.id}
          id={`share-${platform.id}`}
        >
          <Icon name={platform.icon} prefix="fab" />
        </button>
      </abbr>
    ))
  }
</div>

<script>
  const toggle = document.querySelector<HTMLElement>(".share-button");
  const container = document.getElementById("shareOptions");

  if (toggle && container) {
    const options = container.querySelectorAll<HTMLElement>(".share-option");

    toggle.addEventListener("click", (event) => {
      event.preventDefault();
      const hidden =
        container.style.display === "none" || container.style.display === "";

      if (hidden) {
        container.style.display = "block";
        // Stagger the options in rather than popping the whole row at once.
        options.forEach((option, index) => {
          option.style.opacity = "0";
          option.style.display = "block";
          setTimeout(() => {
            option.style.opacity = "1";
            option.style.transition = "opacity .5s ease";
          }, index * 100);
        });
      } else {
        options.forEach((option) => (option.style.display = "none"));
        container.style.display = "none";
      }
    });

    const shareUrls: Record<string, (url: string, title: string) => string> = {
      facebook: (url) => `https://www.facebook.com/sharer/sharer.php?u=${url}`,
      twitter: (url) =>
        `https://twitter.com/intent/tweet?url=${url}&text=Check%20this%20out!`,
      whatsapp: (url) => `https://api.whatsapp.com/send?text=${url}`,
      reddit: (url) =>
        `https://www.reddit.com/submit?url=${url}&title=Interesting%20page`,
      hackernews: (url, title) =>
        `https://news.ycombinator.com/submitlink?u=${url}&t=${title}`,
      telegram: (url, title) =>
        `https://t.me/share/url?url=${url}&text=${title}`,
    };

    options.forEach((option) => {
      option.addEventListener("click", (event) => {
        event.preventDefault();
        const build = shareUrls[option.dataset.share ?? ""];
        if (!build) return;
        window.open(
          build(
            encodeURIComponent(window.location.href),
            encodeURIComponent(document.title),
          ),
          "_blank",
        );
      });
    });
  }
</script>

<style>
  /* Floating share control. `display` on .share-options / .share-option is
     driven by the inline styles the script above sets, so the `display: none`
     here is only the initial state. */
  .share-button {
    position: fixed;
    top: var(--share-button-position);
    right: 15px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 1000;
    display: flex;
    justify-content: center;
    align-items: center;
    border: 1px solid var(--contrast-line-color);
    color: var(--grid-text-color);
    background: var(--body-background-color);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .share-button:hover {
    /* transform: scale(1.08); */
    border-color: var(--nav-bar-text-color);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }

  .share-button:active {
    transform: scale(0.95);
  }

  .share-tooltip {
    position: absolute;
    bottom: 10px;
    right: 100px;
    transform: translateX(50%);
    background-color: rgba(26, 26, 26, 0.92);
    color: #fff;
    padding: 5px 10px;
    border-radius: 4px;
    font-family: var(--body-font);
    font-size: 12px;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    pointer-events: none;
  }

  /* :global — #share-expand is the id handed to <Icon>, a child component,
     so the element never carries this component's scope attribute. */
  :global(#share-expand) {
    font-size: 16px;
  }

  /* .share-button:hover :global(#share-expand) {
    color: var(--top-buttons-hover-color);
  } */

  .share-button:hover .share-tooltip {
    opacity: 1;
    visibility: visible;
  }

  .share-options {
    position: fixed;
    display: none;
    top: calc(var(--share-button-position) + 46px);
    right: 15px;
    z-index: 1001;
  }

  .share-option {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
    font-size: 17px;
    margin: 6px 0;
    border: 1px solid var(--contrast-line-color);
    color: var(--grid-text-color);
    background: var(--body-background-color);
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  #share-facebook:hover  { color: #1877f2; border-color: #1877f2; }
  #share-twitter:hover   { color: #1da1f2; border-color: #1da1f2; }
  #share-whatsapp:hover  { color: #25d366; border-color: #25d366; }
  #share-reddit:hover    { color: #ff4500; border-color: #ff4500; }
  #share-hackernews:hover { color: #ff6600; border-color: #ff6600; }
  #share-telegram:hover  { color: #26a5e4; border-color: #26a5e4; }

  .share-option:active {
    transform: scale(0.95);
  }
</style>
