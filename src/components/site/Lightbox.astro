---
/**
 * Lightbox.astro — click a content image to view it fullscreen, with prev/next
 * across the page. Renders no markup: the script marks matching images and
 * loads the viewer (./lightbox/viewer.ts) on first click, showing a spinner
 * over a backdrop while it downloads.
 */
---

<script>
  import { SPINNER_SVG } from "@utils/spinner";

  // Every image except site chrome and opt-outs.
  const IMAGE_SELECTOR =
    "img:not(#logoImage):not(.no-lightbox):not(.recommend-img img)";

  const images = Array.from(document.querySelectorAll<HTMLImageElement>(IMAGE_SELECTOR));

  if (images.length) {
    // A <Figure>'s caption, as HTML (it may hold math or links). Its "Fig. N:"
    // label is a CSS ::before on the page, so it is written out here.
    const captionOf = (image: HTMLImageElement) => {
      const caption = image.closest("figure")?.querySelector("figcaption");
      if (!caption) return undefined;
      const number = caption.dataset.number;
      return (number ? `Fig. ${number}: ` : "") + caption.innerHTML.trim();
    };

    // Shown in place of a caption: alt text and pixel size, as plain text.
    // The size is left out for an image that hasn't loaded yet.
    const detailsOf = (image: HTMLImageElement) => {
      const size = image.naturalWidth ? `${image.naturalWidth} × ${image.naturalHeight}` : "";
      return [image.alt.trim(), size].filter(Boolean).join("  ·  ");
    };

    // Read at click time rather than now: a lazy image's `currentSrc` is only
    // settled once the browser has picked a candidate for it.
    const slides = () =>
      images.map((image) => ({
        src: image.currentSrc || image.src,
        alt: image.alt,
        caption: captionOf(image),
        details: detailsOf(image),
      }));

    // Covers the page from the click until the viewer has faded in over it.
    // Clicking it or pressing Escape gives up on that open.
    let pending: HTMLElement | null = null;
    const hidePending = () => {
      pending?.remove();
      pending = null;
      document.removeEventListener("keydown", onKey);
    };
    const onKey = (event: KeyboardEvent) => {
      if (event.key === "Escape") hidePending();
    };
    const showPending = () => {
      hidePending();
      const overlay = document.createElement("div");
      overlay.className = "lightbox-pending";
      overlay.setAttribute("role", "status");
      overlay.setAttribute("aria-label", "Loading image viewer");
      overlay.innerHTML = `<span class="spinner">${SPINNER_SVG}</span>`;
      overlay.addEventListener("click", hidePending);
      document.addEventListener("keydown", onKey);
      document.body.append(overlay);
      pending = overlay;
      return overlay;
    };

    images.forEach((image, index) => {
      image.classList.add("lightbox-source");
      image.addEventListener("click", async () => {
        const overlay = showPending();
        try {
          const { openViewer } = await import("./lightbox/viewer");
          // Cancelled (or superseded by another click) while downloading.
          if (pending !== overlay) return;
          // Ready before the overlay began to show: drop it now. A visible one
          // stays until the viewer has faded in over it.
          if (getComputedStyle(overlay).opacity === "0") hidePending();
          openViewer(slides(), index, hidePending);
        } catch {
          hidePending();
        }
      });
    });
  }
</script>

<style>
  :global(.lightbox-source) {
    cursor: pointer;
  }

  /* The viewer's own backdrop (yarl's default #000), so handing over to it is
     seamless. It fades in with the ring after 0.25s: when the viewer is
     already cached it opens before either is ever visible. */
  :global(.lightbox-pending) {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000;
    animation: spinner-delayed-in 0.2s ease-out 0.25s both;
  }

  /* The shared loader (components/_spinner.css) on black: white, like the
     viewer's controls — here and for a slide still downloading in the viewer. */
  :global(.lightbox-pending),
  :global(.yarl__portal) {
    --spinner-track: rgba(255, 255, 255, 0.15);
    --spinner-head: #fff;
  }

  /* Every slide leaves room around the image: at the top for the toolbar, and
     at the bottom so the caption (or the image's details) sits under the image
     instead of over it. Qualified through .yarl__portal to outrank the viewer's stylesheet,
     which loads after this one. */
  :global(.yarl__portal .yarl__slide) {
    padding: max(64px, 13vh) 8vw calc(6.5em + 7vh);
  }

  /* Every image fills that area, scaled up if it is smaller and letterboxed
     (object-fit) if its shape differs, so images display at one consistent
     size; only a strip wider than the screen ends up shorter. The viewer caps
     each image at its natural size with an inline style, which only
     !important can override. */
  :global(.yarl__portal .yarl__slide_image) {
    width: 100%;
    height: 100%;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: contain;
  }

  :global(.yarl__portal .yarl__slide_captions_container) {
    background: none;
  }

  :global(.yarl__portal .yarl__slide_description) {
    font-family: var(--body-font);
    font-size: calc(16px * var(--font-scale, 1));
    line-height: 1.4;
  }

  :global(.yarl__portal .lightbox-details) {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.875em;
  }

  /* The page's link colour is chosen for the page background, not black. */
  :global(.yarl__portal .yarl__slide_description a) {
    color: #8ab4f8;
  }

  /* Touch screens swipe between images, so the arrows only cover the image. */
  @media (hover: none) and (pointer: coarse) {
    :global(.yarl__portal .yarl__navigation_prev),
    :global(.yarl__portal .yarl__navigation_next) {
      display: none;
    }
  }
</style>
