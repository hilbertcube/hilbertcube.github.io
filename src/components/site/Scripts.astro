---
/**
 * Scripts.astro
 * =============
 * Shorthand for the page-specific scripts in BaseLayout's `scripts` slot:
 *
 *   <Fragment slot="scripts">
 *     <Scripts use={["python", "line-numbers"]} />
 *   </Fragment>
 *
 * Aliases and their URLs live in src/utils/scripts.ts. Dependencies (Prism
 * core, a language's base grammar, a plugin's stylesheet) come along
 * automatically, so the list only has to name what the page actually uses.
 */
import { resolveScripts, type ScriptAlias } from "@utils/scripts";

interface Props {
  /** Script aliases to load, in any order. See src/utils/scripts.ts. */
  use: ScriptAlias[];
}

const { use } = Astro.props;
const { css, js } = resolveScripts(use);
---

{css.map((href) => <link rel="stylesheet" href={href} />)}
{js.map((src) => <script is:inline src={src} />)}
