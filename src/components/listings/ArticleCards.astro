---
/**
 * ArticleCards.astro
 * ==================
 * Renders article cards at build time, replacing the client-side article() JS function.
 *
 * Props:
 *   count: max articles to show (default: all)
 *   showDetails: show tags, description, date (default: true)
 *   shuffle: randomise order (default: false)
 *   excludePath URL path to exclude (e.g. the current article)
 */
import { getCollection } from "astro:content";
import { formatDate } from "@utils/formatDate";

interface Props {
  count?: number;
  showDetails?: boolean;
  shuffle?: boolean;
  excludePath?: string;
}

const {
  count,
  showDetails = true,
  shuffle = false,
  excludePath = "",
} = Astro.props;

const IMAGE_ROOT = "/media/Images/";

// Every entry is Zod-validated, so only the current page needs excluding.
let articles = (await getCollection("articles"))
  .map((entry) => entry.data)
  .filter(
    (a) => a.link.replace(/\/$/, "") !== excludePath.replace(/\/$/, ""),
  );

// Shuffle using Fisher-Yates if requested
if (shuffle) {
  for (let i = articles.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [articles[i], articles[j]] = [articles[j], articles[i]];
  }
}

// Slice to requested count
if (count !== undefined) {
  articles = articles.slice(0, count);
}
---

<div id="rec-article-container">
  {
    articles.map((article: any) => (
      <a href={article.link} class="article">
        <div class="article-image-container">
          <img
            loading="lazy"
            src={IMAGE_ROOT + article.image}
            alt={article.title}
            class="no-lightbox"
          />
        </div>
        <div class="article-text-container">
          <div class="article-name">{article.title}</div>
          {showDetails && (
            <>
              <div class="article-topic">
                Tags: {article.topics ? article.topics.join(", ") : "N/A"}
              </div>
              <div class="article-description">{article.description}</div>
              <div class="article-date">Posted {formatDate(article.pubDate)}</div>
            </>
          )}
        </div>
      </a>
    ))
  }
</div>

<style>
  /* Article grid + card styles. The 580px override lives here with the base
     rules rather than in _responsive.css: scoped rules gain an attribute
     selector, so a global media query at equal class specificity would no
     longer win. */
  #rec-article-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-gap: 10px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 10px;
    padding-right: 10px;
    max-width: 100%;
    margin: 0 auto;
  }

  .article {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 10px;
    padding-bottom: 5px;
    text-decoration: none;
    transition: transform 0.2s ease;
    color: black;
    margin: 0;
    height: auto;
  }

  .article-image-container {
    padding: 0;
    overflow: hidden;
    border-radius: 0.5rem;
  }

  .article img {
    width: 100%;
    height: 100%;
    transition: transform 0.2s ease;
    object-fit: cover;
    border-radius: 0.5rem;
  }

  .article:hover .article-image-container img {
    transform: scale(1.03);
  }

  .article:hover .article-name {
    text-decoration: underline;
  }

  .article-name {
    font-size: 19px;
    margin: 10px 0 0;
    text-align: left;
    color: var(--article-name-color);
    font-weight: bold;
    padding-bottom: 10px;
    justify-content: center;
  }

  .article-topic {
    font-size: 12px;
    color: var(--article-date-color);
    margin-top: 2px;
    margin-right: 2px;
    font-weight: bold;
    padding-bottom: 10px;
  }

  .article-description {
    margin-top: 0;
    margin-bottom: 0;
    font-size: 15px;
    line-height: 1.4;
    color: var(--grid-text-color);
    text-align: justify;
    -webkit-hyphens: auto;
    -moz-hyphens: auto;
    -ms-hyphens: auto;
    hyphens: auto;
  }

  .article-date {
    margin-top: 10px;
    margin-bottom: 10px;
    font-size: 12px;
    text-align: left;
    color: var(--article-date-color);
  }

  @media all and (max-width: 580px) {
    #rec-article-container {
      grid-template-columns: 1fr;
      margin: 0;
      gap: 20px;
      padding-left: 5px;
      padding-right: 5px;
    }
  }
</style>
