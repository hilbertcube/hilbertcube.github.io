---
/**
 * PostList.astro
 * ==============
 */
import { getCollection } from "astro:content";
import { formatDate } from "@utils/formatDate";

const posts = (await getCollection("posts")).map((entry) => entry.data);
---

<div id="post-container">
  {
    posts.length === 0 ? (
      <p>No posts available</p>
    ) : (
      <ul class="post-list">
        {posts.map((post: any) => (
          <li>
            <div>
              <a href={post.link} class="post">
                <div class="post-header-row">
                  <h3>{post.title}</h3>
                  <div class="post-date">{formatDate(post.pubDate)}</div>
                </div>
                <p>{post.description}</p>
              </a>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  #post-container ul {
    padding-left: 40px;
  }

  .post {
    text-decoration: none;
    color: inherit;
  }

  .post:hover {
    cursor: pointer;
  }

  .post:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  /* Title and date on one line, sharing a baseline. */
  .post-header-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: nowrap;
  }

  .post-header-row h3,
  .post-header-row .post-date {
    margin: 0;
  }

  .post-date {
    color: var(--nav-bar-text-color);
    position: relative;
    white-space: nowrap;
  }

  @media all and (max-width: 580px) {
    #post-container ul {
      padding-left: 10px;
    }

    /* Not enough room for title and date side by side — stack them. */
    .post-header-row {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
