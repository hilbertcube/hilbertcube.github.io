---
/**
 * CodeBlock.astro — a listing highlighted at build time by Shiki, with a copy
 * button. Props: `language` (Shiki id, default "bash"), `code` (instead of
 * children). Write children with `is:raw`.
 */

import CopyButton from "@components/code/CopyButton.astro";
import { highlight, listing, printKeep } from "@utils/highlight";

interface Props {
  language?: string;
  code?: string;
}

const { language = "bash", code } = Astro.props;
const text = await listing(code, () => Astro.slots.render("default"));
const html = await highlight(text, language);
---

<div
  class:list={["code-container", { "print-keep": printKeep(text) }]}
  style="margin: 25px auto;"
>
  <CopyButton />
  <Fragment set:html={html} />
</div>
