---
/**
 * ShellScript.astro — a bash session highlighted by Shiki, with a prompt before
 * each command.
 *
 * - host            : hostname in the `[user@host] $` prompt (default "pc")
 * - output          : 1-based output lines, e.g. "1, 4-5" (no prompt, plain)
 * - continuationStr : a line ending in this gives the next a `>` prompt
 * - code            : the listing, instead of children
 */

import type { ShikiTransformer } from "shiki";
import CopyButton from "@components/code/CopyButton.astro";
import { highlight, listing, printKeep } from "@utils/highlight";

interface Props {
  host?: string;
  output?: string;
  continuationStr?: string;
  code?: string;
}

const { host = "pc", output, continuationStr, code } = Astro.props;

const text = await listing(code, () => Astro.slots.render("default"));
const lines = text.split("\n");

// "1, 4-5, 7" → {0, 3, 4, 6}, clamped to the listing.
const outputLines = new Set<number>();
for (const section of output?.split(",") ?? []) {
  const [start, end = start] = section.split("-").map((n) => parseInt(n, 10));
  if (Number.isNaN(start) || Number.isNaN(end)) continue;
  for (let i = Math.max(start, 1); i <= Math.min(end, lines.length); i++) {
    outputLines.add(i - 1);
  }
}

const continuationLines = new Set<number>();
if (continuationStr) {
  lines.forEach((line, i) => {
    if (!outputLines.has(i) && line.endsWith(continuationStr)) continuationLines.add(i + 1);
  });
}

const COMMAND_PROMPT = `[user@${host}] $`;
const CONTINUATION_PROMPT = ">";

const prompts: ShikiTransformer = {
  pre(node) {
    this.addClassToHast(node, "command-line");
    // The prompt column is as wide as the widest prompt; the font is monospace.
    node.properties.style += `;--prompt-width:${COMMAND_PROMPT.length}ch`;
  },
  line(node, line) {
    const i = line - 1;
    if (outputLines.has(i)) {
      this.addClassToHast(node, "output");
      node.properties["data-prompt"] = "";
      // Output is not bash: show it as the plain text it is.
      node.children = [{ type: "text", value: lines[i] }];
    } else {
      node.properties["data-prompt"] = continuationLines.has(i)
        ? CONTINUATION_PROMPT
        : COMMAND_PROMPT;
    }
  },
};

const html = await highlight(text, "bash", [prompts]);
---

<div
  class:list={["code-container", { "print-keep": printKeep(text) }]}
  style="margin: 25px auto;"
>
  <CopyButton />
  <Fragment set:html={html} />
</div>

<style>
  /* The prompts are generated content, so they are neither selectable nor part
     of what the Copy button copies. */
  .code-container :global(.command-line .line::before) {
    content: attr(data-prompt);
    display: inline-block;
    width: var(--prompt-width);
    padding-right: 0.8em;
    margin-right: 1em;
    border-right: 1px solid #999;
    letter-spacing: -1px;
    text-align: right;
    opacity: 0.7;
    user-select: none;
  }

  .code-container :global(.command-line .line.output) {
    opacity: 0.7;
  }

  /* The prompt already carries the line's opacity; don't compound it. */
  .code-container :global(.command-line .line.output::before) {
    opacity: 1;
  }
</style>
