---
/**
 * src/components/code/Sample.astro
 * =================================
 * Console output / sample block displayed as preformatted text.
 * Wraps content in <pre class="console"><code>…</code></pre>.
 *
 * Written like the highlighted blocks: `is:raw`, indented to match the page,
 * with `<`, `{`, `}` literal — the shared indentation is stripped (see
 * listing() in utils/highlight.ts). The content is plain text, not HTML.
 *
 *   <Sample is:raw>
 *     Function Foo(x)
 *         while lo <= hi do …
 *   </Sample>
 *
 * `id` / `class` / `style` land on the container so a Sample can be used as a
 * TabBox pane (TabBox shows/hides panes by the shared `tabClass`).
 */
import { listing } from "@utils/highlight";

interface Props {
  code?: string;
  id?: string;
  class?: string;
  style?: string;
}
const { code, id, class: className, style } = Astro.props;
const text = await listing(code, () => Astro.slots.render("default"));
---

<div
  id={id}
  class:list={["code-container", className]}
  style={`margin: 25px auto;${style ? ` ${style}` : ""}`}
>
  <pre class="console"><code>{text}</code></pre>
</div>

<style>
  .console {
    line-height: 2;
    background-color: var(--pre-color);
    font-size: 12px;
    text-align: left;
    position: relative;
    box-sizing: border-box;
    width: 100%;
    overflow-x: auto;
    padding: 10px 25px;
  }
</style>
