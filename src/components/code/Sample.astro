---
/**
 * Sample.astro — console output or pseudo-code as plain preformatted text, no
 * highlighting or copy button. Written with `is:raw` like the other blocks.
 */
import { listing } from "@utils/highlight";

interface Props {
  code?: string;
  id?: string;
  class?: string;
  style?: string;
}
const { code, id, class: className, style } = Astro.props;
const text = await listing(code, () => Astro.slots.render("default"));
---

<div
  id={id}
  class:list={["code-container", className]}
  style={style}
>
  <pre class="console"><code>{text}</code></pre>
</div>

<style>
  .code-container {
    margin: 25px auto;
  }

  .console {
    line-height: 2;
    background-color: var(--pre-color);
    font-size: 12px;
    text-align: left;
    position: relative;
    box-sizing: border-box;
    width: 100%;
    overflow-x: auto;
    padding: 10px 25px;
  }
</style>
