---
/**
 * C.astro  —  inline code (short name; the code-side twin of math's <M>)
 * ----------------------------------------------------------------------
 * A run of code inside a sentence — a flag, an identifier, a filename — as
 * opposed to the `code/` block containers (CodeBlock, CodeBox, ShellScript,
 * Sample, TabBox), which own whole listings.
 *
 *   Compile with <C>-g</C> to embed DWARF debug information.
 *
 * Prism never touches this: inline code carries no `language-*` class, so it
 * is styled, not highlighted, and a page needs no <Scripts> entry for it.
 *
 * As with <M>, a quoted attribute can't hold raw braces or backslashes (Astro
 * eats them), and `{` in slot text opens an expression — so content that needs
 * either goes through a `raw` template literal (see code/raw.astro):
 *
 *   <C>--leak-check=full</C>          (plain text is fine)
 *   <C code={raw`std::vector<T>{}`} />
 *
 * The `.inline-code` rule is scoped to this component, so a hand-written
 * `<code class="inline-code">` in a page is no longer styled — use <C>.
 */
interface Props {
  code?: string;
}
const { code } = Astro.props;
---

<code class="inline-code">{code !== undefined ? code : <slot />}</code>

<style>
  /* Moved here from assets/css/components/_code-blocks.css. `white-space:
     nowrap` with normal overflow-wrap keeps a flag or an identifier on one
     line, so it never breaks across a line the way surrounding prose does. */
  .inline-code {
    font-size: 13px;
    /* background-color: var(--inline-code-color); */
    color: var(--inline-code-text);
    padding: 2px;
    border-radius: 4px;
    /* border: 1px solid var(--box-border); */
    white-space: nowrap;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }
</style>
