---
/**
 * C.astro — inline code: <C>-g</C>, or <C code={raw`std::vector<T>{}`} /> when
 * the content has braces or backslashes. Styled, not highlighted.
 */
interface Props {
  code?: string;
}
const { code } = Astro.props;
---

<code class="inline-code">{code !== undefined ? code : <slot />}</code>

<style>
  /* Keeps a flag or identifier on one line. */
  .inline-code {
    font-size: calc(13px * var(--font-scale));
    color: var(--inline-code-text);
    padding: 2px;
    border-radius: 4px;
    white-space: nowrap;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }
</style>
