---
/**
 * src/components/code/TabBox.astro
 * =================================
 * Tabbed container with clickable tab buttons.
 *
 * Props
 * -----
 * - tabs     : array of { label, id } objects — one per tab
 * - tabClass : CSS class shared by all tab panes
 */

interface Props {
  tabs: { label: string; id: string }[];
  tabClass: string;
}

const { tabs, tabClass } = Astro.props;
---

<div class="box" style="width: auto; max-width: none; margin: 50px auto;">
  <div class="tab-button-container">
    {
      tabs.map((tab, i) => (
        <button
          class={`tab-button${i === 0 ? " tab-effect" : ""}`}
          data-tab-target={tab.id}
          data-tab-class={tabClass}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  <slot />
</div>

<script>
  document
    .querySelectorAll<HTMLElement>(".tab-button[data-tab-target]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const { tabTarget, tabClass } = button.dataset;
        if (!tabTarget || !tabClass) return;

        document
          .querySelectorAll<HTMLElement>(`.${tabClass}`)
          .forEach((pane) => (pane.style.display = "none"));

        const target = document.getElementById(tabTarget);
        if (target) target.style.display = "block";

        button
          .closest(".tab-button-container")
          ?.querySelectorAll(".tab-button")
          .forEach((other) => other.classList.remove("tab-effect"));
        button.classList.add("tab-effect");
      });
    });
</script>
