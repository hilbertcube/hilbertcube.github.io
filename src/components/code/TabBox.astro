---
/**
 * TabBox.astro — tabbed container; each child is a pane, labelled by position
 * from `tabs`. CSS shows the first pane until the script adds ARIA roles and
 * keyboard support; it only touches its own box.
 */

interface Props {
  tabs: string[];
}

const { tabs } = Astro.props;
---

<div class="box tabbox" data-tabbox>
  <div class="tab-button-container" role="tablist">
    {
      tabs.map((label, i) => (
        <button
          type="button"
          class="tab-button"
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          {label}
        </button>
      ))
    }
  </div>
  <div class="tab-panels">
    <slot />
  </div>
</div>

<style>
  .tabbox {
    width: auto;
    max-width: none;
    margin: 50px auto;
  }

  .tab-button-container {
    overflow-x: auto;
    overflow-y: hidden;
    white-space: nowrap;
  }

  .tab-button {
    border-radius: 4px 4px 0 0;
    background-color: var(--pre-color);
    border: 0;
    border-bottom: 1px solid var(--pre-color);
    margin: 0;
    min-width: 80px;
    font-size: 16px;
    padding: 0.3rem;
    color: inherit;
    font-family: inherit;
    cursor: pointer;
  }

  .tab-button[aria-selected="true"] {
    border-bottom: 2px solid #4c83ee;
    background-color: var(--tab-color);
  }

  /* Panes sit flush against the tab strip, so their top-left corner stays square */
  .tabbox .tab-panels > :global(*) {
    margin: 0;
  }

  .tab-panels > :global(.code-container > pre) {
    border-radius: 0 7px 7px 7px;
  }

  .tab-panels > :global([hidden]) {
    display: none;
  }

  /* Before the script runs, show only the first pane */
  .tabbox:not([data-ready]) .tab-panels > :global(:not(:first-child)) {
    display: none;
  }

  /* On paper there are no tabs: print every pane under its tab's label. */
  @media print {
    .tab-button-container {
      display: none;
    }

    .tab-panels > :global([hidden]) {
      display: block;
    }

    .tab-panels > :global([data-tab-label])::before {
      content: attr(data-tab-label);
      display: block;
      font-weight: bold;
      margin: 1em 0 0.4em;
    }
  }
</style>

<script>
  let boxCount = 0;

  document.querySelectorAll<HTMLElement>("[data-tabbox]").forEach((box) => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...box.querySelector(".tab-panels")!.children] as HTMLElement[];
    const prefix = `tabbox-${boxCount++}`;

    panels.forEach((panel, i) => {
      const tab = tabs[i];
      if (!tab) return;
      tab.id = `${prefix}-tab-${i}`;
      panel.id ||= `${prefix}-panel-${i}`;
      tab.setAttribute("aria-controls", panel.id);
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", tab.id);
      panel.tabIndex = 0;
      panel.hidden = i !== 0;
      // Printing shows every pane, headed by this label (see the print rules).
      panel.dataset.tabLabel = tab.textContent!.trim();
    });

    const select = (index: number) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (panels[i]) panels[i].hidden = !selected;
      });
      tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const target = {
          ArrowRight: i === last ? 0 : i + 1,
          ArrowLeft: i === 0 ? last : i - 1,
          Home: 0,
          End: last,
        }[event.key];
        if (target === undefined) return;
        event.preventDefault();
        select(target);
      });
    });

    box.dataset.ready = "";
  });
</script>
