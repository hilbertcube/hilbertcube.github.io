---
/**
 * Quote.astro — the pull quote that opens most articles. CSS supplies the
 * quotation marks and the dash before the author.
 */
interface Props {
  /** The quote itself, without surrounding quotation marks. */
  content: string;
  /** Who said it, without a leading dash. */
  author: string;
}

const { content, author } = Astro.props;
---

<div class="Quote">
  <div class="Quote-content">{content}</div>
  <div class="Quote-author">{author}</div>
</div>

<style>
  .Quote {
    margin-top: 3em;
    margin-bottom: 3em;
    width: 80%;
    margin-left: auto;
    margin-right: auto;
    padding: 4px;
    font-style: italic;
    font-family: serif;
    position: relative;
  }

  .Quote-content {
    font-size: 1.1em;
    -webkit-hyphens: auto;
    -moz-hyphens: auto;
    -ms-hyphens: auto;
    hyphens: auto;
    padding-left: 25px;
    padding-right: 25px;
  }

  .Quote-content::before {
    content: "\201C";
  }

  .Quote-content::after {
    content: "\201D";
  }

  .Quote-author {
    font-size: 1.1em;
    text-align: right;
    position: relative;
  }

  .Quote-author::before {
    content: "--\00a0";
  }

  /* The rule running down the left edge of the block. */
  .Quote::after {
    position: absolute;
    content: "";
    background: var(--underline-color);
    height: 100%;
    width: 2px;
    bottom: 0;
    left: 0;
  }

  @media all and (max-width: 580px) {
    .Quote {
      width: 100%;
    }

    .Quote-author {
      font-size: 1em;
    }
  }
</style>
