---
/**
 * PubDate.astro
 * =============
 * Renders an article/post's publication date under the title.
 *
 * - `pubDate` is optional: with no prop, the component resolves the page's own
 *   collection entry from its URL (see @utils/getEntryMeta). Pass `pubDate`
 *   explicitly to override, or to use this outside /articles/ and /posts/.
 * - The raw collection value is an ISO "YYYY-MM-DD" string, run through
 *   `formatDate` internally so pages never import the formatter themselves.
 * - Styled by the scoped `.date` rule below.
 * - Carries the "Save as PDF" button (SavePdf), so every article and post has one.
 */
import SavePdf from "@components/article/SavePdf.astro";
import { formatDate } from "@utils/formatDate";
import { resolveEntryMeta } from "@utils/getEntryMeta";

interface Props {
  pubDate?: string;
}

const { pubDate: pubDateProp } = Astro.props;
const pubDate =
  pubDateProp ?? (await resolveEntryMeta(Astro.url.pathname)).data.pubDate;
---

<div class="date-row">
  <div class="date">Posted {formatDate(pubDate)}</div>
  <SavePdf />
</div>

<style>
  .date-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5em 1em;
    margin-top: 0;
    margin-bottom: 60px;
  }

  .date {
    color: var(--nav-bar-text-color);
    font-style: italic;
  }
</style>
