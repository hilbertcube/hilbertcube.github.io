---
/**
 * References.astro — the "References" section, rendered from the
 * `_references.ts` beside the page's `index.astro` (found from the URL; the
 * build fails if missing). Each item gets `id="ref-<key>"`.
 */
import { formatReference, type Reference } from "@utils/references";

interface Props {
  /** Section heading; also its TOC label and URL fragment. */
  title?: string;
}

const { title = "References" } = Astro.props;

const files = import.meta.glob<Record<string, Reference>>(
  "/src/pages/**/_references.ts",
  { eager: true, import: "default" },
);

// "/src/pages/articles/<slug>/_references.ts" → "/articles/<slug>"
const route = (file: string) =>
  file.replace(/^\/src\/pages/, "").replace(/\/_references\.ts$/, "");
const pathname = Astro.url.pathname.replace(/\/(index\.html)?$/, "");

const file = Object.keys(files).find((f) => route(f) === pathname);
if (!file) {
  throw new Error(
    `<References>: no _references.ts next to the page for ${Astro.url.pathname}`,
  );
}

const entries = Object.entries(files[file]).map(([key, ref]) => ({
  key,
  segments: formatReference(ref),
}));
---

<section>
  <h2>{title}</h2>
  <ol class="reference">
    {
      entries.map(({ key, segments }) => (
        <li id={`ref-${key}`}>
          {segments.map((s) =>
            typeof s === "string" ? (
              s
            ) : "em" in s ? (
              <em>{s.em}</em>
            ) : (
              <a href={s.href}>{s.href}</a>
            ),
          )}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .reference {
    justify-self: start;
    line-height: 1.6;
    counter-reset: item;
    padding-left: 0;
  }

  .reference li {
    display: block;
    position: relative;
    text-align: left;
    margin-bottom: 0.5em;
    padding-left: 2em;
    overflow-wrap: break-word;
    -webkit-hyphens: auto;
    hyphens: auto;
  }

  /* The marker is taken out of flow rather than sitting inline at the start of
     the line. An in-flow inline-block leaves the newline between `<li>` and the
     citation text as a rendered space, which pushes the first line ~4px right of
     every wrapped line; out of flow, that whitespace is at the start of the line
     and collapses away, so the hanging indent lines up exactly on the 2em
     padding. */
  .reference li::before {
    content: "[" counter(item) "]";
    counter-increment: item;
    position: absolute;
    left: 0;
  }

  /* Body links stay on one line (base/_typography.css); a long URL here has to
     break instead. The scoped selector outranks `.content-grid a:not([class])`. */
  .reference a:not([class]) {
    white-space: normal;
  }
</style>
