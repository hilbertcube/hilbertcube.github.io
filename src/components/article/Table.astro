---
/**
 * Table.astro — a `.p-table` inside the `.table-wrapper` that scrolls it on
 * narrow screens. `id`, `class` and other attributes land on the `<table>`.
 *
 * Page rules for cell content: from a scoped style use
 * `:global(.p-table) td { … }`; a global rule needs
 * `.table-wrapper .p-table .cls` to outrank the scoped rules below.
 */
interface Props {
  id?: string;
  class?: string;
}

const { id, class: className, ...rest } = Astro.props;
---

<div class="table-wrapper">
  <table id={id} class:list={["p-table", className]} {...rest}>
    <slot />
  </table>
</div>

<style>
  /* Table contents are slot content (page-scoped), hence :global(). */

  .table-wrapper {
    overflow-x: auto;
  }

  .p-table {
    width: auto;
    max-width: 100%;
    margin: 30px auto;
    border: 1px solid var(--grid-text-color);
    font-size: 0.95em;
  }

  .p-table :global(caption) {
    caption-side: bottom;
    font-size: calc(14px * var(--font-scale));
    padding-top: 10px;
    text-align: center;
  }

  .p-table :global(thead tr) {
    border-bottom: 1px solid var(--grid-text-color);
  }

  .p-table :global(th),
  .p-table :global(td) {
    padding: 8px 14px;
    vertical-align: top;
    text-align: left;
  }

  .p-table :global(th) {
    text-align: center;
  }

  .p-table :global(th + th),
  .p-table :global(td + td) {
    border-left: 1px solid var(--grid-text-color);
  }

  .p-table :global(tbody tr + tr) {
    border-top: 1px solid var(--box-border, rgba(128, 128, 128, 0.3));
  }
</style>
