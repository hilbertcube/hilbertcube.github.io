---
/**
 * src/components/TableOfContents.astro
 * =====================================
 * Sidebar Table of Contents component.
 *
 * Normally you don't render this yourself: pass `toc` to BaseLayout and it
 * builds the list from the page's own `<section>` / `<h2>` / `<h3>` markup.
 * See src/utils/toc.ts for how headings are picked up and how to override a
 * label (`data-toc="..."`) or skip one (`data-toc="skip"`).
 *
 * Props
 * -----
 * - items : Array of TocItem objects (label, href?, children?)
 * - title : Heading above the list (default "Table of Contents")
 *
 * Usage (manual list, when a page needs something the markup can't express)
 * -----
 * <TableOfContents items={[
 *   { label: "Introduction", href: "#intro" },
 *   { label: "Methods", href: "#methods", children: [
 *     { label: "Subsection A", href: "#sub-a" },
 *   ]},
 * ]} />
 */
import type { TocItem } from "@utils/toc";

interface Props {
  items: TocItem[];
  title?: string;
}

const { items, title = "Table of Contents" } = Astro.props;

/** Labels come from page markup, so they must be escaped, not trusted. */
function escapeHtml(text: string): string {
  return text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function renderItems(items: TocItem[]): string {
  return items
    .map((item) => {
      const label = escapeHtml(item.label);
      const link = item.href
        ? `<a href="${escapeHtml(item.href)}">${label}</a>`
        : label;
      const children = item.children
        ? `\n<ul>${renderItems(item.children)}</ul>`
        : "";
      return `<li>${link}${children}</li>`;
    })
    .join("\n");
}
---

{
  items.length > 0 && (
    <div class="toc">
      <header class="major">
        <h2>{title}</h2>
      </header>
      <ul set:html={renderItems(items)} />
    </div>
  )
}

<!--
  Note: BaseLayout imports this component on every page, and Astro picks the
  pages a hoisted <script> lands on from the module graph, not from whether the
  markup above actually rendered — so this ships site-wide regardless of `toc`.
  That is fine (initTocHighlight() returns immediately when there are no TOC
  links) and it is the point: the behaviour travels with the markup instead of
  with a hand-maintained alias list that a new TOC page could forget.
-->
<script>
  import { initTocHighlight } from "./tocHighlight";
  initTocHighlight();
</script>

<style>
  /* The <ul>'s contents are injected with set:html (see renderItems above), so
     the generated <li>/<a>/nested <ul> carry no scope attribute — every rule
     that reaches into them has to opt out of scoping with :global(). Only
     .toc and its <header> are real template elements. */
  .toc {
    padding: 0 15px;
    padding-top: 10px;
    padding-bottom: 25px;
    margin: 0;
  }

  .toc > header {
    border-top: 1px solid #b4b4b4;
    padding-top: 5px;
  }

  .toc ul :global(ul) {
    padding-left: 10px;
    margin: 0;
  }

  .toc :global(li) {
    line-height: 1.4;
  }

  .toc ul :global(li) {
    padding: 5px;
    text-align: left;
    background: var(--nav-bar-color);
    cursor: pointer;
    border-left: 1.5px solid var(--li-border-color);
  }

  /* Hover colour deepens with nesting, so the depth of the entry you are
     pointing at is readable at a glance. */
  .toc ul :global(li:hover) {
    border-left: 2px solid red;
  }

  .toc ul :global(li li:hover) {
    border-left: 2px solid blueviolet;
  }

  .toc ul :global(li li li:hover) {
    border-left: 2px solid green;
  }

  .toc :global(a) {
    text-decoration: none;
    color: inherit;
  }

  /* Set by tocHighlight.ts on the entry for the section now in view. */
  .toc :global(a.active) {
    color: var(--toc-focus-color);
  }
</style>
