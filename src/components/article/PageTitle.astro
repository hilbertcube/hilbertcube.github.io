---
/**
 * PageTitle.astro
 * ===============
 * Renders an article/post's `<h1>` heading under the topic tags.
 *
 * - Both props are optional: with none, the component resolves the page's own
 *   collection entry from its URL (see @utils/getEntryMeta), and `variant`
 *   follows from which collection that is. Pass either prop to override, or to
 *   use this outside /articles/ and /posts/.
 * - Articles and posts style their heading differently, so the class is picked
 *   from `variant`: `.title` for articles, `.post-title` for posts.
 */
import { resolveEntryMeta } from "@utils/getEntryMeta";

interface Props {
  title?: string;
  variant?: "article" | "post";
}

const { title: titleProp, variant: variantProp } = Astro.props;

const entry =
  titleProp === undefined || variantProp === undefined
    ? await resolveEntryMeta(Astro.url.pathname)
    : null;

const title = titleProp ?? entry!.data.title;
const variant =
  variantProp ?? (entry!.kind === "posts" ? "post" : "article");
---

<h1 class={variant === "post" ? "post-title" : "title"}>{title}</h1>

<style>
  .title {
    font-family: var(--top-bar-font);
    padding-bottom: 5px;
    padding-top: 30px;
  }

  .post-title {
    padding-top: 30px;
    font-size: 2em;
  }

  @media all and (max-width: 580px) {
    .title {
      font-size: 1.9em;
    }
  }
</style>
