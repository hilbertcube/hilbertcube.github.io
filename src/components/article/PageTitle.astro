---
/**
 * PageTitle.astro
 * ===============
 * Renders an article/post's `<h1>` heading under the topic tags.
 *
 * - Articles and posts style their heading differently, so the class is picked
 *   from `variant`: `.title` for articles (the default), `.post-title` for
 *   posts. Both rules live in src/assets/css/pages/_home.css, with the
 *   small-screen override on `h1.title` in src/assets/css/utils/_responsive.css.
 */
interface Props {
  title: string;
  variant?: "article" | "post";
}

const { title, variant = "article" } = Astro.props;
---

<h1 class={variant === "post" ? "post-title" : "title"}>{title}</h1>
