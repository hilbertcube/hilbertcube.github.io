---
/**
 * FrontImage.astro — the banner under an article's title. `width` (desktop
 * only) goes through a custom property; children become the caption.
 */
interface Props {
  src: string;
  alt?: string;
  width?: string;
  fetchpriority?: "high" | "low" | "auto";
}

const {
  src,
  alt = "banner",
  width = "100%",
  fetchpriority = "high",
} = Astro.props;
---

<figure class="front-img-figure" style={`--front-img-width: ${width};`}>
  <img class="front-img" src={src} alt={alt} fetchpriority={fetchpriority} />
  {
    Astro.slots.has("default") && (
      <figcaption>
        <slot />
      </figcaption>
    )
  }
</figure>

<style>
  .front-img-figure {
    margin: 0;
  }

  .front-img {
    display: block;
    width: var(--front-img-width, 100%);
    border-radius: var(--image-radius);
    height: auto;
    margin: auto;
  }

  @media all and (max-width: 580px) {
    .front-img {
      width: 100%;
    }
  }
</style>
