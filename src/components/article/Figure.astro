---
/**
 * Figure.astro — the only way to place a body image. `width` applies on desktop
 * through a custom property, so the breakpoints below (80% at 1080px, 100% at
 * 580px) win. Children become the caption, numbered by base/_typography.css.
 */
import { pageAsset } from "@utils/pageAsset";

interface Props {
  /** Lets <Ref to="…" /> cite the figure (only a captioned figure is numbered). */
  id?: string;
  /** Image source; a relative path ("plot.webp") is in the page's own public/ folder. */
  src: string;
  /** Alt text; pass "" for purely decorative figures. */
  alt?: string;
  /** Desktop width of the image, e.g. "70%". Use "auto" for intrinsic size. */
  width?: string;
  /** Optional hard cap, e.g. "520px". Defaults to the container width. */
  maxWidth?: string;
  /** Narrower caption than the figure, e.g. "70%". Defaults to full width. */
  captionWidth?: string;
  /** Drop the figure's margins, for tight column layouts. */
  flush?: boolean;
  /**
   * Figures sit in the article body, below the fold, so they default to
   * `lazy`. Pass `eager` for one that has to be up straight away.
   */
  loading?: "lazy" | "eager";
}

const {
  id,
  src,
  alt = "",
  width = "100%",
  maxWidth,
  captionWidth,
  flush = false,
  loading = "lazy",
} = Astro.props;

const style = [
  `--figure-img-width: ${width}`,
  maxWidth && `--figure-img-max-width: ${maxWidth}`,
  captionWidth && `--figure-caption-width: ${captionWidth}`,
]
  .filter(Boolean)
  .join("; ");
---

<figure id={id} class:list={["article-figure", { flush }]} style={style}>
  <img class="article-img" src={pageAsset(src, Astro.url.pathname)} alt={alt} loading={loading} />
  {
    Astro.slots.has("default") && (
      <figcaption class="article-caption">
        <slot />
      </figcaption>
    )
  }
</figure>

<style>
  /* Overrides the browser's default `1em 40px`: the horizontal inset made a
     figure's percentage widths mean something different in every column. */
  .article-figure {
    margin: 1.5rem 0;
    padding: 0;
  }

  .article-figure.flush {
    margin: 0;
  }

  .article-img {
    display: block;
    width: var(--figure-img-width, 100%);
    max-width: var(--figure-img-max-width, 100%);
    height: auto;
    margin-left: auto;
    margin-right: auto;
    border-radius: var(--image-radius);
  }

  .article-caption {
    width: var(--figure-caption-width, auto);
  }

  @media all and (max-width: 1080px) {
    .article-img {
      width: 80%;
    }
  }

  @media all and (max-width: 580px) {
    .article-img {
      width: 100%;
    }

    .article-caption {
      width: auto;
    }
  }
</style>
