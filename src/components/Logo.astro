---
/**
 * Logo.astro
 * ==========
 */
import { Image } from 'astro:assets';
import logoSrc from '../assets/images/Logo/pendulum_logo.webp';
import Icon from './Icon.astro';
---

<div id="logo">
  <a
    href="https://github.com/hilbertcube/neumanncondition"
    class="logo-link"
  >
    <Image
      id="logoImage"
      src={logoSrc}
      alt="website-logo"
      widths={[150, 300, 450]}
      sizes="(max-width: 600px) 150px, 300px"
    />
    <div class="logo-title">
      <Icon name="github" prefix="fab" class="logo-github-icon" />
      <span class="logo-repo">
        hilbertcube/hilbertcube.github.io 
      </span>
    </div>
  </a>
</div>

<div class="side-nav-container">
  <details open class="side-nav">
    <summary class="side-summary">Navigation</summary>
    <ul>
      <li>
        <a class="side-buttons" href="/">
          <summary class="side-nav-summary" id="Home-button">home</summary>
        </a>
      </li>
      <li>
        <a class="side-buttons" href="/about" id="About-button">
          <summary class="side-nav-summary">about</summary>
        </a>
      </li>
      <!-- <li>
        <a class="side-buttons" href="/privacy-policy/" id="Contact-button">
          <summary class="side-nav-summary">POLICY</summary>
        </a>
      </li> -->
    </ul>
  </details>
</div>

<style>

  /* Logo section */
  #logo {
    margin-bottom: 20px;
    overflow: hidden;
  }

  #logoImage {
    display: block;
    object-fit: contain;
    height: auto;
    margin: 30px auto;
    transition: transform .2s ease;
  }
  #logoImage {
    width: 45%;
    margin-bottom: 10px;
    border-radius: 50%;
  }

  #logoImage:hover {
    transform: scale(1.05);
  }

  .logo-link {
    text-decoration: none;
    color: inherit;
  }

  /* GitHub-badge style title: mark on the left, repo path beside it. */
  .logo-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45em;
    font-family: Computer-Modern;
    text-align: left;
    font-size: 1.1rem;
    line-height: 1.2;
  }

  .logo-title:hover {
    text-decoration: underline;
  }

  .logo-title :global(.logo-github-icon) {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .logo-repo {
    word-break: break-word;
  }

  .logo-repo :global(.logo-external-icon) {
    font-size: 0.6rem;
  }
</style>
