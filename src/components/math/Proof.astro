---
/**
 * Proof.astro — proof environment; CSS adds an italic "Proof." (or `label`)
 * lead-in to the first paragraph, so the body must open with a `<p>`.
 */
interface Props {
  /** The lead-in word, without its trailing period. Defaults to "Proof". */
  label?: string;
}

const { label = "Proof" } = Astro.props;
---

<div class="proof" style={`--proof-label: "${label}."`}>
  <slot />
</div>

<style>
  /* The paragraphs are slot content, hence :global(). */
  .proof {
    margin: 1.75rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--box-border, rgba(128, 128, 128, 0.4));
    line-height: 1.7;
  }

  .proof > :global(p:first-child)::before {
    content: var(--proof-label, "Proof.") " ";
    font-style: italic;
    font-weight: 600;
  }

  .proof > :global(p:first-child) {
    margin-top: 0;
  }

  .proof > :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
