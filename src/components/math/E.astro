---
/**
 * E.astro — display equation, typeset by katex-render.js. Pass LaTeX as
 * <E>{tex`…`}</E> or code={tex`…`}; a quoted attribute loses its backslashes.
 */
interface Props {
  code?: string;
}
const { code } = Astro.props;
---

<div class="equation">{code !== undefined ? code : <slot />}</div>
