---
/**
 * Theorem.astro — a numbered theorem (the number is assigned at build time by
 * @utils/numbering). Give it an `id` to cite it with <Ref to="…" />.
 */
interface Props {
  name?: string;
  id?: string;
}

const { name, id } = Astro.props;
const dataName = name ? ` (${name})` : "";
---

<div class="theorem" id={id} data-num="theorem" data-theorem-name={dataName}>
  <slot />
</div>
