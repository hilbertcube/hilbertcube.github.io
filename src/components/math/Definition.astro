---
/**
 * Definition.astro — a numbered definition (the number is assigned at build time by
 * @utils/numbering). Give it an `id` to cite it with <Ref to="…" />.
 */
interface Props {
  name?: string;
  id?: string;
}

const { name, id } = Astro.props;
const dataName = name ? ` (${name})` : "";
---

<div class="definition" id={id} data-num="definition" data-definition-name={dataName}>
  <slot />
</div>
