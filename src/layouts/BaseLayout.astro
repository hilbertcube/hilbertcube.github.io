---
/**
 * BaseLayout.astro
 * ================
 * Shared layout for all pages.
 */
import TopBar from "@components/site/TopBar.astro";
import ShareButton from "@components/site/ShareButton.astro";
import Lightbox from "@components/site/Lightbox.astro";
import Logo from "@components/site/Logo.astro";
import Footer from "@components/site/Footer.astro";
import HighlightsAndAttribute from "@components/site/HighlightsAndAttribute.astro";
import ArticleCards from "@components/listings/ArticleCards.astro";
import TableOfContents from "@components/article/TableOfContents.astro";
import { extractToc, type TocOptions } from "@utils/toc";
import { prism } from "@utils/scripts";


// Vite bundles all @import statements into one minified CSS file
import "@assets/css/main.css";

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  /** ID of the nav button to highlight, e.g. "Home-button" */
  activeButton?: string;
  /**
   * Sidebar Table of Contents, built from this page's own markup: every
   * `<h2>`/`<h3>` that sits in (or carries) an `id` becomes an entry, so adding
   * a section to the page is all it takes to add it to the TOC. Pass `true` for
   * the defaults, or an options object (e.g. `toc={{ maxLevel: 4 }}`).
   * See src/utils/toc.ts for label overrides and skipping.
   */
  toc?: boolean | TocOptions;
}

const {
  title,
  description = "",
  keywords = "math, physics, programming, coding, computer science, computer simulation",
  activeButton = "",
  toc = false,
} = Astro.props;

const isArticle = Astro.url.pathname.startsWith("/articles/");
const tex = String.raw;

// The page body is rendered here (rather than left to `<slot />` below) so the
// TOC can be derived from the finished HTML before the sidebar is emitted. The
// body is then injected as markup, which is fine for this site because every
// page is static HTML — a hydrated island (`client:*`) would not survive it.
const body = Astro.slots.has("default")
  ? await Astro.slots.render("default")
  : "";
const tocItems = toc ? extractToc(body, toc === true ? {} : toc) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-00W722FWP2"
      is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-00W722FWP2");
    </script>

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title} | hilbertcube</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="subject" content="Mathematics, Physics, and Computer Science Articles, Posts, Tutorials, and more" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Don Le, ledongduu@gmail.com" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Preconnect to third-party origins -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />

    <!-- Every code block is line-numbered, so this one is global; the rest of
         the Prism assets are per-page (see src/utils/scripts.ts). -->
    <link rel="stylesheet" href={prism("plugins/line-numbers/prism-line-numbers.min.css")} />

    <!-- KaTeX (self-hosted) for math rendering -->
    <link rel="stylesheet" href="/katex/katex.min.css" />

    <!-- Active nav button highlighting -->
    {
      activeButton && (
        <style
          set:html={`
      #${activeButton} {
        text-decoration: underline;
      }
    `}
        />
      )
    }

    <!-- Page-specific head content (extra styles, meta, etc.) -->
    <slot name="head" />

    <!-- Apply dark mode before first paint to prevent flash -->
    <script is:inline>
      if (localStorage.getItem("mode") === "dark") {
        document.documentElement.classList.add("dark-mode");
      }
    </script>
  </head>

  <body class="light-mode">
    <TopBar />
    <ShareButton />
    <Lightbox />

    <nav class="navbar" id="navbar">
      <div class="logo-and-side-nav">
        <Logo />
      </div>
      <!-- Sidebar: `toc` renders a Table of Contents built from the page's own
           sections, and the "sidebar" slot adds any other page-specific content
           above the highlights; the highlights and attribution below are
           rendered on every page. -->
      <TableOfContents items={tocItems} />
      <slot name="sidebar" />
      <div class="highlights-and-attribute">
        <HighlightsAndAttribute />
      </div>
    </nav>

    <main class="general-wrapper" data-pagefind-body>
      <!-- Page-specific content goes here (rendered in the frontmatter above) -->
      <Fragment set:html={body} />

      {
        isArticle && (
          <div class="content-grid" style="margin-top: -100px" data-pagefind-ignore>
            <section>
              <h2>More Articles</h2>
              <ArticleCards
                count={4}
                showDetails={true}
                shuffle={true}
                excludePath={Astro.url.pathname.replace(/\/$/, "")}
              />
            </section>
          </div>
        )
      }

      <footer data-pagefind-ignore>
        <Footer />
      </footer>
    </main>

    <script is:inline src="/assets/js/scripts.js"></script>

    <!-- KaTeX: library, then auto-render extension, then our render driver -->
    <script is:inline defer src="/katex/katex.min.js"></script>
    <script is:inline defer src="/katex/contrib/auto-render.min.js"></script>
    <script is:inline defer src="/assets/js/katex-render.js"></script>

    <!-- Pagefind on-page highlight (via ?pagefind-highlight=…). The script only
         marks matches; it doesn't scroll — so we scroll to the first match,
         preferring one inside the linked #section. No-ops without the index (dev). -->
    <script is:inline type="module">
      import("/pagefind/pagefind-highlight.js")
        .then((m) => {
          const Highlighter = m.default;

          // Scroll to the first match, preferring one inside section `id`.
          function scrollToMatch(id) {
            let tries = 0;
            (function poll() {
              const marks = document.querySelectorAll("mark.pagefind-highlight");
              if (!marks.length) {
                if (tries++ < 25) setTimeout(poll, 60);
                return;
              }
              let target = null;
              if (id) {
                const sec = document.getElementById(id);
                if (sec) {
                  for (const mk of marks) {
                    if (
                      sec.contains(mk) ||
                      sec.compareDocumentPosition(mk) &
                        Node.DOCUMENT_POSITION_FOLLOWING
                    ) {
                      target = mk;
                      break;
                    }
                  }
                }
              }
              (target || marks[0]).scrollIntoView({
                block: "center",
                behavior: "smooth",
              });
            })();
          }

          // Initial run: page opened with ?pagefind-highlight=…
          new Highlighter({ addStyles: false });
          const hash = decodeURIComponent((location.hash || "").slice(1));
          scrollToMatch(hash);

          // Late-loading images can shift the target after the first scroll, so
          // re-scroll once the page has fully loaded — unless the reader has
          // already taken over scrolling.
          if (document.readyState !== "complete") {
            let userMoved = false;
            const flag = () => (userMoved = true);
            ["wheel", "touchstart", "keydown", "pointerdown"].forEach((e) =>
              addEventListener(e, flag, { once: true, passive: true }),
            );
            addEventListener(
              "load",
              () => {
                if (!userMoved) scrollToMatch(hash);
              },
              { once: true },
            );
          }

          // Same-page search navigation: re-highlight for a new query and scroll,
          // without a page reload / new tab.
          window.__pagefindGoInPage = function (url) {
            const u = new URL(url, location.href);
            history.replaceState(null, "", u.pathname + u.search + u.hash);
            document.querySelectorAll("mark.pagefind-highlight").forEach((mk) => {
              const p = mk.parentNode;
              p.replaceChild(document.createTextNode(mk.textContent), mk);
              p.normalize();
            });
            new Highlighter({ addStyles: false });
            scrollToMatch(decodeURIComponent((u.hash || "").slice(1)));
          };
        })
        .catch(() => {});
    </script>

    <!-- Additional page-specific scripts -->
    <slot name="scripts" />
  </body>
</html>

<style>
  /* The <footer> element itself lives in this layout; its contents are styled
     in components/site/Footer.astro. */
  footer {
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    background-color: #111111;
    color: white;
    text-align: center;
    padding-top: 25px;
    padding-bottom: 20px;
  }
</style>
