---
/**
 * src/pages/posts/tested-food-places/index.astro
 * =================================================
 * Post: Tested Food Places
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import TopicTags from "@components/article/TopicTags.astro";
import Icon from "@components/ui/Icon.astro";
import Scripts from "@components/site/Scripts.astro";
import { formatDate } from "@utils/formatDate";
import { getEntryMeta } from "@utils/getEntryMeta";

const meta = await getEntryMeta("posts", Astro.url.pathname);
---

<BaseLayout
  title="Post - Tested Food Places"
  description="A list of tested food places including restaurants, cafes, and dessert shops"
  keywords="tested food places, restaurants, cafes, dessert shops, food reviews, dining, eating out"
  toc
>
  <Fragment slot="head">
    <style is:inline>
      .image-container {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        justify-content: center;
      }
      .food-img {
        width: calc(25% - 5px);
        max-width: 100%;
        height: auto;
        object-fit: cover;
      }
      .food {
        -webkit-hyphens: auto;
        -moz-hyphens: auto;
        -ms-hyphens: auto;
        hyphens: auto;
        overflow-wrap: break-word;
        word-wrap: break-word;
      }
      /* The table style itself is .p-table in components/_content.css;
         only the column-specific rules for these tables are below.
         Ratings read better centred; the category cell spans its whole block,
         so it carries its own right rule (rows below it start at "Place" and
         would otherwise leave the column edge unruled). */
      .p-table .rating {
        text-align: center;
        white-space: nowrap;
      }
      .p-table .category {
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        font-weight: 600;
        border-right: 1px solid var(--grid-text-color);
      }
      @media (max-width: 768px) {
        .food-img {
          width: calc(50% - 5px);
        }
        /* Scoped through .food so these outrank the shared .p-table
           rules in the bundled stylesheet, which the browser sees after this
           block. */
        .food .p-table {
          font-size: 0.9em;
        }
        .food .p-table th,
        .food .p-table td {
          padding: 6px 8px;
        }
      }
    </style>
  </Fragment>

  <Fragment slot="scripts">
    <Scripts use={["blog-setting"]} />
  </Fragment>

  <div class="content-grid">
    <header>
      <TopicTags topics={meta.topics} />
      <h1 class="post-title">{meta.title}</h1>
      <div class="date">{formatDate(meta.pubDate)}</div>
    </header>

    <section class="food" id="list">
