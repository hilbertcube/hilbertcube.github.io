---

<BaseLayout toc>
  <Fragment slot="head">
    <style is:inline>
      .image-container {
        margin: 1.5rem 0;
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        justify-content: center;
      }
      .food-img {
        width: calc(25% - 5px);
        max-width: 100%;
        height: auto;
        object-fit: cover;
        border-radius: var(--image-radius);
      }
      /* The table style itself lives in components/article/Table.astro;
         only the column-specific rules for these tables are below.
         Ratings read better centred; the category cell spans its whole block,
         so it carries its own right rule (rows below it start at "Place" and
         would otherwise leave the column edge unruled).
         Qualified through .table-wrapper — Table.astro's cell rules are
         scoped, which buys them an extra attribute of specificity, and a bare
         .p-table .rating would now lose to them. */
      .table-wrapper .p-table .rating {
        text-align: center;
        white-space: nowrap;
      }
      .table-wrapper .p-table .category {
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        font-weight: 600;
        border-right: 1px solid var(--grid-text-color);
      }
      @media (max-width: 768px) {
        .food-img {
          width: calc(50% - 5px);
        }
        /* Qualified through .content-grid so these outrank Table.astro's
           scoped rules, which the browser sees after this block. */
        .content-grid .table-wrapper .p-table {
          font-size: 0.9em;
        }
        .content-grid .table-wrapper .p-table th,
        .content-grid .table-wrapper .p-table td {
          padding: 6px 8px;
        }
      }
    </style>
  </Fragment>

  <header>
    <TopicTags />
    <PageTitle />
    <PubDate />
  </header>

  <section>
    <h2>The Big List</h2>
    <section>
      <h3>
        Have Tried <Icon name="check" />
      </h3>
      <Table>
        <thead>
          <tr>
            <th>Category</th>
            <th>Place</th>
            <th>Location</th>
            <th>Rating</th>
            <th>Notes</th>
          </tr>
        </thead>
        <tbody>
          <PlaceRows groups={tried} />
        </tbody>
      </Table>
    </section>

    <section>
      <h3>
        Have Yet to Try <Icon name="xmark" />
      </h3>
      <Table>
        <thead>
          <tr>
            <th>Category</th>
            <th>Place</th>
            <th>Location</th>
          </tr>
        </thead>
        <tbody>
          <PlaceRows groups={wanted} />
        </tbody>
      </Table>
    </section>
  </section>


  <section>
    <h2>Gallery</h2>
    <p>Click on image to view full size.</p>
    <div class="image-container">
      {gallery.map(({ file, alt }) => (
        <img
          class="food-img"
          loading="lazy"
          src={`/posts/tested-food-places/${file}`}
          {alt}
        />
      ))}
    </div>
  </section>
</BaseLayout>
