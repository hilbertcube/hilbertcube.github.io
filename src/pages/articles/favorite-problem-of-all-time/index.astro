import BaseLayout from "@layouts/BaseLayout.astro";
import TopicTags from "@components/article/TopicTags.astro";
import { formatDate } from "@utils/formatDate";
import { getEntryMeta } from "@utils/getEntryMeta";

const meta = await getEntryMeta("articles", Astro.url.pathname);

import Problem from "@components/math/Problem.astro";
import Solution from "@components/math/Solution.astro";
import E from "@components/math/E.astro";
import { tex } from "@components/math/tex.astro";
import Scripts from "@components/site/Scripts.astro";
---

<BaseLayout
  title="Favorite Problems"
  description="My Favorite Problems of All Time"
  keywords="data structures, algorithms, c++, cpp, computer science"
  toc
>
  <Fragment slot="head">
    <style>
      .front-img {
        display: block;
        width: 100%;
        border-radius: 10px;
        height: auto;
        margin: auto;
      }
      .algorithm_box {
        width: 50%;
      }
      @media all and (max-width: 580px) {
        .algorithm_box {
          width: 100%;
        }
      }
      #nlogn .katex {
        font-size: inherit !important;
      }
    </style>
  </Fragment>

  <div class="content-grid">
    <header>
      <TopicTags topics={meta.topics} />
      <h1 class="title">{meta.title}</h1>
      <div class="date">{formatDate(meta.pubDate)}</div>
      <div class="Quote">
        <div class="Quote-content">
          &#8220;Real mathematics must be justified as art if it can be
          justified at all.&#8221;
        </div>
        <div class="Author">- G.H. Hardy</div>
      </div>
    </header>

    <section id="series-problem">
      <h2>A Quite Difficult Series Problem</h2>
      <Problem>
        Let $\lcm(1):=1$. Prove that the series
        <E>{tex`\begin{equation}\sum_{k=1}^{\infty}\frac{1}{\lcm(1,2,3,...,k)}\end{equation}`}</E>
        converges to an irrational number.
      </Problem>

      <Solution summary="Solution">
          To know if the series converges, we use the comparison test. Let
          $L_k:=\lcm(1,2,...,k)$, for $k=1,2,3,...$. By definition, $L_1:=1$ and
          note that for $k\geq 2$, $0&lt; L_k\leq k(k-1)$. That is, for each
          integer $N>0$,
          <E>{tex`\begin{equation} \sum_{k=1}^{N}\frac{1}{L_k}\leq 1+\sum_{k=2}^{N}\frac{1}{k(k-1)}\leq 1+\sum_{k=2}^{\infty}\frac{1}{k(k-1)}=1+\sum_{k=2}^{\infty}\left(\frac{1}{k-1}-\frac{1}{k} \right)=2. \end{equation}`}</E>
          This means that $S=\sum_&#123;k=1&#125;^&#123;\infty&#125;\frac&#123;1&#125;&#123;L_k&#125;$
          exists and is a positive real number between 1 and 2. To prove that this
          number is irrational, we argue by contradiction. Suppose on the contrary
          that $S$ is rational, and it can be written as
          <E>{tex`\begin{equation} S=\frac{a}{b}, \end{equation}`}</E>
          where $(a,b)\in\Z\times\Z\backslash\&#123;0\&#125;$, and $a, b$ are coprimes.
          Let $p_1,p_2,p_3,...,p_r,...$ be the increasing sequence of prime numbers
          greater than $b$. Using the famous Bertrand's Postulate, we know that
          <E>{tex`\begin{equation}p_r < p_{r+1}< 2p_r\quad\Rightarrow\quad p_{r+1}-p_r< p_r,\;\forall r=1,2,3,...\end{equation}`}</E>
          Change this to a non-strict inequality, we have
          <E>{tex`\begin{equation}p_{r+1}-p_r\leq p_r-1\end{equation}`}</E>
          for each $r\in\Z^+$. We will now show that $p_&#123;r+1&#125;-p_r$ is indeed
          strictly less than $p_r-1$. To do this, we need to recall a useful lemma
          that we will not prove formally:
          <div class="lemma">
            <strong>Lemma 1:</strong> There are infinitely primes of the form $3k+2$.
          </div>
          Lemma (1) simply states that for infinitely many primes $p_r$, it holds
          that $p_r\equiv 2\;(\modular 3)$. Now, note that if $p_&#123;r+1&#125;-p_r=p_r-1$,
          then $p_&#123;r+1&#125;-2\equiv 1\;(\modular 3)$, which means that $p_&#123;r+1&#125;\equiv
          0\;(\modular 3)$, and is indeed true for $3$, but not true for infinitely
          many primes $p_r$. Hence, $p_&#123;r+1&#125;-p_r&lt; p_r-1$ for infinitely
          many $r$. Now, notice that
          <E>{tex`\begin{align*} S-S_{p_1-1}&=\left(\sum_{k=1}^{\infty}\frac{1}{L_k}-\sum_{k=1}^{p_1-1}\frac{1}{L_k}\right)=\sum_{k=p_1}^{\infty}\frac{1}{L_k}=\frac{1}{L_{p_1}}+\frac{1}{L_{p_1+1}}+\frac{1}{L_{p_1+2}}+\cdots\\ &=\left(\frac{1}{L_{p_1}}+\frac{1}{L_{p_1+1}}+\cdots+\frac{1}{L_{p_2-1}}\right)+\left(\frac{1}{L_{p_2}}+\frac{1}{L_{p_2+1}}+\cdots+\frac{1}{L_{p_3-1}}\right)+\cdots\\ &=\sum_{r=1}^{\infty}\sum_{k=p_r}^{p_{r+1}-1}\frac{1}{L_k}=\frac{1}{L_{p_1-1}}\sum_{r=1}^{\infty}\sum_{k=p_r}^{p_{r+1}-1}\frac{L_{p_1-1}}{L_k}. \end{align*}`}</E>
          Notice also that $L_&#123;p_1-1&#125;=\lcm(1,2,...,p_1-1)$ is a multiple
          of all primes less than $p_1$, and $L_k=\lcm(1,2,...,k)=\lcm(1,...,p_r)$
          is a multiple of all primes less than $p_r$. Therefore
          <E>{tex`\begin{align*} 0 < S-S_{p_1-1}&\leq \frac{1}{L_{p_1-1}}\sum_{r=1}^{\infty}\sum_{k=p_r}^{p_{r+1}-1}\frac{2\cdot 3\cdot 5\cdots (p_1-1)}{2\cdot 3\cdot 5\cdots (p_1-1)p_1\cdots p_r}\\ &=\frac{1}{L_{p_1-1}}\sum_{r=1}^{\infty}\sum_{k=p_r}^{p_{r+1}-1}\frac{1}{p_1p_2...p_r}=\frac{1}{L_{p_1-1}}\sum_{r=1}^{\infty}\frac{1}{p_1p_2\cdots p_r}\sum_{k=p_r}^{p_{r+1}-1}1\\ &=\frac{1}{L_{p_1-1}}\sum_{r=1}^{\infty}\frac{p_{r+1}-p_r}{p_1p_2\cdots p_r}< \frac{1}{L_{p_1-1}}\sum_{r=1}^{\infty}\frac{p_r-1}{p_1p_2\cdots p_r}\\ &=\frac{1}{L_{p_1-1}}\sum_{r=1}^{\infty}\left(\frac{1}{p_1\;...\;p_{r-1}}-\frac{1}{p_1...p_r}\right)\\ &=\frac{1}{L_{p_1-1}}\left(1-\frac{1}{p_1}+\frac{1}{p_1}-\frac{1}{p_1p_2}+\frac{1}{p_1p_2}-\frac{1}{p_1p_2p_3}+\cdots\right)\\ &=\frac{1}{L_{p_1-1}}, \end{align*}`}</E>
          which is the same as saying that
          <E>{tex`\begin{equation} SL_{p_1-1}-S_{p_1-1}L_{p_1-1}< 1. \end{equation}`}</E>
          Recall that we defined $p_1$ to be a prime number greater than $b$, therefore,
          $b\in\&#123;1,2,...,p_1-1\&#125;$, and hence $L_&#123;p_1-1&#125;=\lcm(1,2,...,p_1-1)$
          must be a multiple of $b$; i.e., $L_&#123;p_1-1&#125;=kb$ for some integer
          $k$. This means that
          <E>{tex`\begin{equation}SL_{p_1-1}=\frac{a}{b}\cdot kb=a\cdot k\in\N.\end{equation}`}</E>
          Let us remind ourselves of the formula of $\lcm$ for a list of numbers.
          <div class="lemma">
            <strong>Lemma 2:</strong> For an integer $m\geq k$, we have
            <E>{tex`\begin{equation} L_m=\lcm(1,2,...,m)=\lcm(\lcm(1,2,...,k),k+1,...,m). \end{equation}`}</E>
          </div>
          Ok, but why? This lemma is left as an exercise for the reader.<br
          /><br />

          The lemma says that $L_m$ is a number divisible by $\lcm(1,2,...,k)$,
          and hence $\lcm(1,...,m)=h\lcm(1,...,k)$, for some $h\in\Z$.
          Therefore, for the term $S_&#123;p_1-1&#125;L_&#123;p_1-1&#125;$,
          <E>{tex`\begin{equation}S_{p_1-1}L_{p_1-1}=\sum_{k=1}^{p_1-1}\frac{L_{p_1-1}}{L_k}=\sum_{k=1}^{p_1-1}\frac{\lcm(1,2,...,p_1-1)}{\lcm(1,2,...,k)}\in\N,\;1\leq k\leq p_1-1.\end{equation}`}</E>
          This means that
          <E>{tex`\begin{equation}SL_{p_1-1}-S_{p_1-1}L_{p_1-1}\in\N,\end{equation}`}</E>
          which is completely nonsensical, since this implies that there is an integer
          somewhere between $0$ and $1$. Therefore, the original statement must be
          true and $S$ is irrational.
        </Solution>
    </section>

    <section id="inequality-problem">
      <h2>An Interesting Inequality Problem</h2>
      <p>
        I encountered this problem back when I was in high school. I remember it
        took me more than 2 hours to solve.
      </p>
      <Problem>
        Consider the set $\mathcal&#123;S&#125;$ of all integers $x$ satisfying
        <E>{tex`\begin{equation} 4yx^6 + \log_2(yx^6) - 2\log_2(x) + 1 \geq 2^{[\log_2(2x)]^2} + [\log_2(x)]^2, \end{equation}`}</E>
        for some integer $y$. How many integer values of $y$ are there such that the
        set $\mathcal&#123;S&#125;$ contains no more than 64 elements?
      </Problem>
      <p>You can try solving this, or view the solution right below :)</p>
      <Solution>
          For this inequality to make sense, $x$ and $y$ must be greater than 0.
          We now restate the problem more generally: if $\mathcal&#123;S&#125;$
          has $n$ elements, then the inequality must hold for $n$ integers $x$
          satisfying:
          <E>{tex`\begin{equation}4yx^6 + \log_2(yx^6) - 2\log_2(x) + 1 \geq 2^{[\log_2(2x)]^2} + [\log_2(x)]^2.\end{equation}`}</E>
          Rearranging the inequality, we obtain:
          <E>{tex`\begin{align*} 4yx^6 + \log_2(yx^6) + \log_2(4) &\geq 2^{[\log_2(2x)]^2} + [\log_2(x)]^2 + 2\log_2(x) + 1 \\[0.2em] 2^{\log_2(4yx^6)} + \log_2(4yx^6) &\geq 2^{[\log_2(2x)]^2} + [\log_2(x) + 1]^2 \\[0.2em] 2^{\log_2(4yx^6)} + \log_2(4yx^6) &\geq 2^{[\log_2(2x)]^2} + [\log_2(2x)]^2 \end{align*}`}</E>
          Let $u(x) = \log_2(4yx^6)$ and $v(x) = [\log_2(2x)]^2$. Then, based on the
          above, we have: <E>{tex`\begin{equation} 2^{u(x)} + u(x) \geq 2^{v(x)} + v(x) \end{equation}`}</E> To proceed, let's introduce a useful property of monotonic functions:
          <div class="lemma">
            <strong>Lemma 1:</strong> Let $f: D \to \mathbb&#123;R&#125;$ be a function
            defined on a subset $D \subseteq \mathbb&#123;R&#125;$. Let $u(x)$ and
            $v(x)$ be functions such that for all $x$, $u(x), v(x) \in D$ and $u(x)
            > v(x)$. Then:
            <ul>
              <li class="bullet">
                If $f$ is strictly increasing on $D$, then $f(u(x)) > f(v(x))$.
              </li>
              <li class="bullet">
                If $f$ is strictly decreasing on $D$, then $f(u(x)) &lt;
                f(v(x))$.
              </li>
            </ul>
            <strong>Note:</strong> If $f$ is non-strictly monotonic (i.e., non-decreasing
            or non-increasing), then the inequalities become non-strict:
            <ul>
              <li class="bullet">
                If $f$ is non-decreasing on $D$, then $f(u(x)) \geq f(v(x))$.
              </li>
              <li class="bullet">
                If $f$ is non-increasing on $D$, then $f(u(x)) \leq f(v(x))$.
              </li>
            </ul>
            <em
              >See the definition of monotonic functions
              <a
                href="https://en.wikipedia.org/wiki/Monotonic_function#:~:text=In%20calculus%2C%20a%20function,order%20(see%20Figure%202)."
                class="url">here</a
              >.</em
            >
          </div>
          Returning to the inequality:
          <E>{tex`\begin{equation}2^{\log_2(4yx^6)} + \log_2(4yx^6) \geq 2^{[\log_2(2x)]^2} + [\log_2(2x)]^2,\end{equation}`}</E>
          Let $f(x) = 2^x + x$, a strictly increasing function. Then, by Lemma 1:
          <E>{tex`\begin{equation}\log_2(4yx^6) \geq [\log_2(2x)]^2 \end{equation}`}</E>
          Solving for $y$:
          <E>{tex`\begin{align*} 4yx^6 &\geq 2^{[\log_2(2x)]^2} = 2^{\log_2(2x) \cdot \log_2(2x)} = (2x)^{\log_2(2x)} \\ &= 2x \cdot x^{\log_2(2x)} = 2x^{\log_2(x) + 2} \end{align*}`}</E>
          Therefore:
          <E>{tex`\begin{equation}y \geq \frac{1}{2}x^{\log_2(x) - 4} > 0\end{equation}`}</E>
          Define $f(x) = \frac&#123;1&#125;&#123;2&#125;x^&#123;\log_2(x) - 4&#125;$.
          Our goal is to find the minimum of this function. Proceeding via standard
          calculus:
          <E>{tex`\begin{align*} f'(x) &= \frac{1}{2}x^{\log_2(x) - 4}\left[\frac{\log_2(x) - 4}{x} + \frac{\ln(x)}{x\ln(2)}\right] \\ &= \frac{1}{2}x^{\log_2(x) - 4} \cdot \frac{1}{x} \left[ \log_2(x) + \frac{\ln(x)}{\ln(2)} - 4 \right] \\ &= \frac{1}{2}x^{\log_2(x) - 5} (2\log_2 x - 4) \end{align*}`}</E>
          Setting $f'(x) = 0$, we have either $\frac&#123;1&#125;&#123;2&#125;x^&#123;\log_2(x)
          - 5&#125; = 0$ or $2\log_2 x - 4 = 0$. The first case is impossible since
          $x > 0$. Thus: <E>{tex`\begin{equation} 2\log_2 x - 4 = 0 \Rightarrow x = 4 \end{equation}`}</E> It's easy to verify
          that $f'(x)$ changes sign from negative to positive at $x = 4$, so $x =
          4$ is a minimum. The core result is that:
          <E>{tex`\begin{equation}4yx^6 + \log_2(yx^6) - 2\log_2(x) + 1 \geq 2^{[\log_2(2x)]^2} + [\log_2(x)]^2\end{equation}`}</E>
          is true if and only if $y \geq f(x) > 0$. For $\mathcal&#123;S&#125;$ to
          have $n$ elements, it must be true that:
          <E>{tex`\begin{equation}0 < y \leq \left\lfloor f(n + 1) \right\rfloor\end{equation}`}</E>
          Plugging in $n = 64$ gives $0 &lt; y &lt; 2319$. Therefore, there are 2319
          values of $y$ satisfying the inequality.
        </Solution>
    </section>
  </div>
  

  <Fragment slot="scripts">
    <Scripts use={["blog-setting", "cpp", "line-numbers"]} />
  </Fragment>
</BaseLayout>
