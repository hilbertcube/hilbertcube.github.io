---
import BaseLayout from "@layouts/BaseLayout.astro";
import TopicTags from "@components/TopicTags.astro";
import Theorem from "@components/math/Theorem.astro";
import Problem from "@components/math/Problem.astro";
import Solution from "@components/math/Solution.astro";
import E from "@components/math/E.astro";
import { tex } from "@components/math/tex.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { getCollection } from "astro:content";

const slug = Astro.url.pathname.replace(/\/$/, "");
const article = (await getCollection("articles")).find(
  (e) => e.data.link.replace(/\/$/, "") === slug,
);
const meta = article?.data;

if (!meta) {
  throw new Error(`Article metadata not found for slug: ${slug}`);
}
