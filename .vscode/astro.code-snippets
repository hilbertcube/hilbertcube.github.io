// Project snippets for the component library.
//
// Why this file exists, and why it is named this way:
//
//   - Project snippets are only read from `.vscode/*.code-snippets`. The old
//     `.vscode/html.json` sat in a path VS Code never looks at, so nothing in
//     it ever fired. Its MathJax snippet is carried over below.
//   - `.astro` files report language id `astro`, not `html`, so snippets in
//     `~/.config/Code/User/snippets/html.json` don't reach them either. Hence
//     `"scope": "astro"`.
//
// How to trigger: type the component name *without* the angle bracket, then
// accept — `Table`, not `<Table`. The astro word pattern treats `<` as a
// separator, so a leading `<` would survive the expansion and give `<<Table>`.
//
// These write markup only; they cannot add the import. That comes from the
// language server's auto-import completion, which is what
// `astro.auto-import-cache.enabled: false` in settings.json restores for
// newly created components.
//
// The code snippets write `is:raw` for you and put the cursor on the line
// below the tag: a listing that starts there, indented like the page, is
// dedented by the component (see "the indentation gotcha" in COMPONENTS.md).
//
// Props here mirror docs/COMPONENTS.md — if a component's props change, this
// file does not follow on its own.
{
  "MathJax inline math": {
    "scope": "astro",
    "prefix": "\\(",
    "body": ["\\($1\\)"],
    "description": "Inline math \\( ... \\)"
  },

  "Inline code": {
    "scope": "astro",
    "prefix": "C",
    "body": ["<C>$1</C>"],
    "description": "Inline code — a flag, identifier or filename in prose"
  },
  "Inline math": {
    "scope": "astro",
    "prefix": "M",
    "body": ["<M>{tex`$1`}</M>"],
    "description": "Inline math, escape-free via tex"
  },
  "Display equation": {
    "scope": "astro",
    "prefix": "E",
    "body": ["<E>{tex`\\\\begin{equation} $1 \\\\end{equation}`}</E>"],
    "description": "Numbered display equation"
  },

  "Table": {
    "scope": "astro",
    "prefix": "Table",
    "body": [
      "<Table>",
      "  <thead>",
      "    <tr><th>$1</th><th>$2</th></tr>",
      "  </thead>",
      "  <tbody>",
      "    <tr><td>$3</td><td>$4</td></tr>",
      "  </tbody>",
      "</Table>"
    ],
    "description": "Table — emits the .table-wrapper / .p-table pair"
  },
  "Figure": {
    "scope": "astro",
    "prefix": "Figure",
    "body": ["<Figure src=\"/articles/$1/$2.webp\" width=\"${3:70%}\">$4</Figure>"],
    "description": "Body image with a numbered caption"
  },
  "FrontImage": {
    "scope": "astro",
    "prefix": "FrontImage",
    "body": ["<FrontImage src=\"/articles/$1/banner.webp\" />"],
    "description": "Article banner"
  },
  "Two columns": {
    "scope": "astro",
    "prefix": "TwoColumns",
    "body": ["<TwoColumns>", "  <div>$1</div>", "  <div>$2</div>", "</TwoColumns>"],
    "description": "Two-column block"
  },
  "Quote": {
    "scope": "astro",
    "prefix": "Quote",
    "body": ["<Quote content=\"$1\" author=\"$2\" />"],
    "description": "Pull quote"
  },

  "Code box": {
    "scope": "astro",
    "prefix": "CodeBox",
    "body": ["<CodeBox language=\"${1:python}\"${2: lineNumbers} is:raw>", "\t$0", "</CodeBox>"],
    "description": "Framed code block with a copy button"
  },
  "Code block": {
    "scope": "astro",
    "prefix": "CodeBlock",
    "body": ["<CodeBlock language=\"${1:bash}\" is:raw>", "\t$0", "</CodeBlock>"],
    "description": "Unframed code block with a copy button"
  },
  "Shell script": {
    "scope": "astro",
    "prefix": "ShellScript",
    "body": ["<ShellScript is:raw>", "\t$0", "</ShellScript>"],
    "description": "Terminal session with a prompt"
  },
  "Sample output": {
    "scope": "astro",
    "prefix": "Sample",
    "body": ["<Sample is:raw>", "\t$0", "</Sample>"],
    "description": "Console output or pseudo-code — not a runnable listing"
  },

  "Theorem": {
    "scope": "astro",
    "prefix": "Theorem",
    "body": ["<Theorem name=\"$1\">", "  $0", "</Theorem>"],
    "description": "Numbered theorem block"
  },
  "Problem": {
    "scope": "astro",
    "prefix": "Problem",
    "body": ["<Problem>", "  $0", "</Problem>"],
    "description": "Numbered problem block"
  },
  "Solution": {
    "scope": "astro",
    "prefix": "Solution",
    "body": ["<Solution>", "  $0", "</Solution>"],
    "description": "Collapsible solution block"
  },
  "Proof": {
    "scope": "astro",
    "prefix": "Proof",
    "body": ["<Proof>", "  <p>$0</p>", "</Proof>"],
    "description": "Proof environment — body must open with a <p>"
  },

  "Section": {
    "scope": "astro",
    "prefix": "section",
    "body": ["<section>", "  <h2>$1</h2>", "  $0", "</section>"],
    "description": "Page section — its id is generated from the heading at build time"
  }
}
