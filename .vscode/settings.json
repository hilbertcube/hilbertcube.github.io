{
    "emmet.includeLanguages": {
        "javascript": "javascriptreact",
        "astro": "html"
    },
    "emmet.triggerExpansionOnTab": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/.hg/store/**": true,
      "**/.git/**": true,
      "**/node_modules/**": true,
      "**/.vscode/**": true
    },
    // "github.copilot.enable": false,
    "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },
  "css.validate": true,
  // CSS Peek: its default language list has no "astro", so go-to-definition
  // on class names silently does nothing in .astro files. Setting this key
  // replaces the defaults wholesale, so the full list is repeated here.
  "cssPeek.peekFromLanguages": [
    "astro",
    "html",
    "django-html",
    "laravel-blade",
    "razor",
    "vue",
    "blade",
    "pug",
    "jade",
    "handlebars",
    "php",
    "twig",
    "md",
    "nunjucks",
    "javascript",
    "javascriptreact",
    "erb",
    "typescript",
    "typescriptreact",
    "HTML (Eex)",
    "html-eex",
    "ejs",
    "hbs",
    "svelte"
  ],
  "cssPeek.peekToExclude": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/dist/**",
    "**/.astro/**"
  ],
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode",
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.formatOnType": false,
    "editor.suggest.showWords": false
  },
  // The auto-import cache is what feeds component completions (typing `<Ta`
  // offering `Table` and writing the import for you). Its own docs note it
  // "can cause issues with new files not being detected" — a component added
  // this session never shows up until the cache is rebuilt. Off means the
  // language server resolves imports live: slightly slower, always current.
  // withastro/astro#14642. Applied on restart.
  "astro.auto-import-cache.enabled": false,
  "astro.content-intellisense": true,
  // Every `\x` inside a template literal is painted as an escape sequence.
  // The TypeScript grammar's rule is `\\(x[0-9A-Fa-f]{2}|...|.|$)` — that
  // trailing `.` matches *any* character after a backslash — and it applies to
  // tagged templates with no exception for String.raw. So in
  // `<E>{tex`\begin{equation}\left(\dfrac...`}</E>` the \b \l \d \s \e all
  // light up as escapes they are not: `tex` is String.raw, so those backslashes
  // are literal LaTeX.
  //
  // The grammar can't be told about String.raw, so the fix is to repaint the
  // scope: give escapes inside template literals the theme's own string colour,
  // which makes them disappear back into the string. Per theme, because a
  // textMateRule has to name a colour and can't inherit one.
  //
  // Cost: a *real* escape in a template literal also loses its highlight. One
  // site in this repo — the `\n` in TableOfContents.astro's renderItems.
  // Using another theme? Add its name and its `string` colour here.
  "editor.tokenColorCustomizations": {
    "[Dark Modern][Dark+][Dark (Visual Studio)]": {
      "textMateRules": [
        {
          "scope": "string.template constant.character.escape",
          "settings": { "foreground": "#ce9178" }
        }
      ]
    },
    "[Dark 2026]": {
      "textMateRules": [
        {
          "scope": "string.template constant.character.escape",
          "settings": { "foreground": "#a5d6ff" }
        }
      ]
    },
    "[Light Modern][Light+][Light (Visual Studio)]": {
      "textMateRules": [
        {
          "scope": "string.template constant.character.escape",
          "settings": { "foreground": "#a31515" }
        }
      ]
    },
    "[Light 2026]": {
      "textMateRules": [
        {
          "scope": "string.template constant.character.escape",
          "settings": { "foreground": "#0a3069" }
        }
      ]
    }
  },
  "github.copilot.enable": {
    "*": false
  }
}
